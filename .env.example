# Database URL. SQLite is the default for local development.
# For Docker Compose, the API service is given a Postgres URL automatically.
# DATABASE_URL and the older alias DB_URL are both accepted.
DATABASE_URL=sqlite:///./insight.db

# Directory for uploaded CSVs and trained model artifacts.
STORAGE_DIR=storage

# Dashboard: URL of the InsightForge API.
API_BASE=http://localhost:8000

# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

LOG_LEVEL=INFO

# Comma-separated allowed CORS origins for the API (the Streamlit dashboard).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Used by docker-compose.yml for the Postgres service.
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight
POSTGRES_DB=insightdb
